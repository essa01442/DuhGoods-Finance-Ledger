{
  "name": "DuhGoodsImportSource",
  "label": "Import Source",
  "create": true,
  "isSingle": false,
  "isChild": false,
  "naming": "autoincrement",
  "fields": [
    {
      "fieldname": "sourceName",
      "label": "Source Name",
      "fieldtype": "Data",
      "required": true,
      "section": "Default"
    },
    {
      "fieldname": "sourceNamespace",
      "label": "Source Namespace",
      "fieldtype": "Data",
      "required": true,
      "readOnly": true,
      "section": "Default"
    },
    {
      "fieldname": "sourceType",
      "label": "Source Type",
      "fieldtype": "Select",
      "required": true,
      "options": ["woocommerce", "bank_statement", "psp_export", "manual"],
      "section": "Default"
    },
    {
      "fieldname": "importedAt",
      "label": "Imported At",
      "fieldtype": "Datetime",
      "readOnly": true,
      "section": "Default"
    },
    {
      "fieldname": "sourceFile",
      "label": "Source File",
      "fieldtype": "Data",
      "readOnly": true,
      "section": "Default"
    },
    {
      "fieldname": "sourceHash",
      "label": "Source Hash (SHA-256)",
      "fieldtype": "Data",
      "readOnly": true,
      "section": "Default"
    },
    {
      "fieldname": "recordCount",
      "label": "Record Count",
      "fieldtype": "Int",
      "readOnly": true,
      "default": 0,
      "section": "Default"
    },
    {
      "fieldname": "importedCount",
      "label": "Imported",
      "fieldtype": "Int",
      "readOnly": true,
      "default": 0,
      "section": "Default"
    },
    {
      "fieldname": "skippedCount",
      "label": "Skipped",
      "fieldtype": "Int",
      "readOnly": true,
      "default": 0,
      "section": "Default"
    },
    {
      "fieldname": "exceptionCount",
      "label": "Exceptions",
      "fieldtype": "Int",
      "readOnly": true,
      "default": 0,
      "section": "Default"
    },
    {
      "fieldname": "errorCount",
      "label": "Errors",
      "fieldtype": "Int",
      "readOnly": true,
      "default": 0,
      "section": "Default"
    },
    {
      "fieldname": "status",
      "label": "Status",
      "fieldtype": "Select",
      "required": true,
      "options": ["pending", "imported", "partial", "failed"],
      "default": "pending",
      "section": "Default"
    },
    {
      "fieldname": "errorSummary",
      "label": "Error Summary",
      "fieldtype": "Data",
      "readOnly": true,
      "section": "Default"
    }
  ],
  "quickEditFields": [
    "sourceName",
    "sourceNamespace",
    "sourceType",
    "importedAt",
    "sourceFile",
    "recordCount",
    "importedCount",
    "skippedCount",
    "exceptionCount",
    "errorCount",
    "status"
  ]
}
